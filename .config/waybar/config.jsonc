// One bar per output. Shared settings and modules live in modules.jsonc.
// Waybar matches outputs by name, not orientation, so the portrait monitor
// is listed explicitly (it is `transform 90` in the sway config).
[
    // Landscape monitors: vertical bar on the right
    {
        "output": "!DP-2",
        "position": "right",
        "include": ["~/.config/waybar/modules.jsonc"]
    },

    // Portrait monitor: horizontal bar on top
    {
        "output": "DP-2",
        "position": "top",
        "include": ["~/.config/waybar/modules.jsonc"],

        // Single-line variants of the formats that stack vertically in modules.jsonc
        "clock": {
            "format": "󰣆 {:%d.%m.%y  󰥔 %H:%M:%S}",
            "format-alt": "󰥔 {:%H:%M:%S}"
        },
        "pulseaudio#audio": {
            "format-bluetooth-muted": "󰂯 󰖁"
        }
    }
]
